# ── Database ──────────────────────────────────────────────────────────────
# Local dev uses SQLite (zero setup). For PRODUCTION, follow DEPLOY.md:
# switch the Prisma provider to "postgresql" and use a Neon/Supabase URL here.
DATABASE_URL="file:./dev.db"
# DIRECT_URL is only used in production (Postgres) for migrations / `prisma db push`.
# Set DATABASE_URL to the POOLED url and DIRECT_URL to the DIRECT url.
# DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────
# Long random string. Generate one: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI provider ───────────────────────────────────────────────────────────
# Set ONE of the two. Without either, tools run in "demo mode" (sample results).
#
# Groq (recommended) — fast, has a free tier, cheaper than Claude.
#   Key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Anthropic (optional) — Claude Haiku. Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email (optional) ──────────────────────────────────────────────────────
# Used for soft email verification. WITHOUT a key, verify links are printed to
# the server console — so the whole flow is testable before you sign up anywhere.
# Free tier: https://resend.com
RESEND_API_KEY=
# Sender address. For first tests, Resend allows: onboarding@resend.dev
# In production, verify your domain and use e.g. noreply@yourdomain.com
EMAIL_FROM=Copyflow <onboarding@resend.dev>

# ── Stripe (payments) ─────────────────────────────────────────────────────
# Required to charge for Pro. Create a $9/mo recurring Price in the Stripe
# dashboard and paste its id into STRIPE_PRICE_ID. Set the webhook secret from
# your endpoint (or `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
